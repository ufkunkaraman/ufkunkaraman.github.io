---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import TechStack from "@/components/TechStack.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <img
          src="https://avatars.githubusercontent.com/u/42344340?v=4"
          alt="Ufkun Karaman — Senior DevOps Engineer"
          width={96}
          height={96}
          class="border-accent/60 ring-accent/20 size-24 shrink-0 rounded-full border-2 object-cover ring-4"
        />
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
              Ufkun Karaman<span class="text-accent">.</span>
            </h1>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="inline-flex items-center"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="stroke-accent scale-110 stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p class="text-accent mt-1 font-mono text-sm font-medium">
            Senior DevOps Engineer | SRE | System Administrator
          </p>
        </div>
      </div>

      <p class="text-foreground/90 mt-6 leading-relaxed">
        I am a Senior DevOps Engineer and System Administrator experienced in
        designing, building, and optimizing modern, scalable, and secure
        infrastructure—while modernizing legacy systems. My core focus spans
        Kubernetes orchestration, CI/CD automation, deep observability &amp;
        distributed APM, compliance-ready log management, and Linux server
        performance tuning &amp; security hardening.
      </p>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
        {
          socials.length > 0 && (
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-muted-foreground text-sm whitespace-nowrap">
                {t.home.socialLinks}:
              </span>
              <Socials />
            </div>
          )
        }
        <LinkButton
          href={getRelativeLocaleUrl(locale, "about")}
          class="border-border bg-surface hover:border-accent hover:text-accent rounded-md border px-3 py-1.5 font-mono text-xs font-medium transition-colors"
        >
          About &amp; Expertise →
        </LinkButton>
      </div>
    </section>

    <TechStack />

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <p class="text-accent font-mono text-xs font-medium tracking-wider uppercase">
            02 // Selected Playbooks
          </p>
          <h2 class="mt-1 text-2xl font-bold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <p class="text-accent font-mono text-xs font-medium tracking-wider uppercase">
            03 // Engineering Notes
          </p>
          <h2 class="mt-1 text-2xl font-bold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
