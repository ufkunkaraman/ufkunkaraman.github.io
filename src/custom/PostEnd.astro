---
import type { CollectionEntry } from "astro:content";
import Comments from "@/components/Comments.astro";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
void post;
---

<div
  class="border-border bg-surface mt-8 flex flex-col items-start justify-between gap-3 rounded-lg border p-4 sm:flex-row sm:items-center"
>
  <p class="text-muted-foreground text-sm">
    Found this guide useful in production? Support open technical docs:
  </p>
  <div class="flex flex-wrap gap-2">
    <a
      href="https://github.com/sponsors/ufkunkaraman"
      target="_blank"
      rel="noopener noreferrer"
      class="border-border bg-background hover:border-accent hover:text-accent rounded border px-3 py-1 font-mono text-xs font-medium transition-colors"
    >
      GitHub Sponsors
    </a>
    <a
      href="https://www.buymeacoffee.com/ufkunkaraman"
      target="_blank"
      rel="noopener noreferrer"
      class="border-border bg-background hover:border-accent hover:text-accent rounded border px-3 py-1 font-mono text-xs font-medium transition-colors"
    >
      Buy Me a Coffee
    </a>
  </div>
</div>

<Comments />
