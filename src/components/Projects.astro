---
import { PROJECTS } from "@/data/projects";
---

<section id="projects" class="border-border border-b py-8">
  <div
    class="mb-5 flex flex-col justify-between gap-2 sm:flex-row sm:items-end"
  >
    <h2 class="text-2xl font-bold tracking-tight">Open-Source Projects</h2>
    <a
      href="https://github.com/ufkunkaraman?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent text-xs font-medium hover:underline"
    >
      All repositories on GitHub →
    </a>
  </div>

  <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2">
    {
      PROJECTS.map(project => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-border bg-surface hover:bg-surface-hover hover:border-accent/50 group flex flex-col justify-between rounded-lg border p-4 transition-colors"
        >
          <div>
            <div class="mb-1.5 flex items-center justify-between gap-2">
              <h3 class="text-accent font-mono text-sm font-semibold group-hover:underline">
                {project.name}
              </h3>
              <span class="border-border bg-background text-muted-foreground rounded border px-2 py-0.5 font-mono text-[11px]">
                {project.language}
              </span>
            </div>
            <p class="text-muted-foreground mb-3 text-xs leading-relaxed">
              {project.description}
            </p>
          </div>
          <ul class="flex flex-wrap gap-1.5" aria-label={project.name}>
            {project.tags.map(tag => (
              <li class="border-border bg-background text-foreground/85 rounded border px-2 py-0.5 font-mono text-xs">
                {tag}
              </li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</section>
